SNOWIMPACT_ENV=development
SNOWIMPACT_DATABASE_URL=sqlite:///./snowimpact.db
SNOWIMPACT_REDIS_URL=redis://localhost:6379/0
SNOWIMPACT_API_KEY=change-me-in-production
SNOWIMPACT_DEMO_MODE=true
SNOWIMPACT_LOG_LEVEL=INFO
SNOWIMPACT_CORS_ORIGINS=http://localhost:3000
SNOWIMPACT_RAW_SQL_RETENTION_DAYS=30
SNOWIMPACT_HISTORY_DAYS=90
SNOWIMPACT_MAX_ACCESS_HISTORY_ROWS=50000
SNOWIMPACT_TELEMETRY=false

# Snowflake. Use key-pair/OAuth in production.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=SNOWIMPACT_MONITOR
SNOWFLAKE_WAREHOUSE=SNOWIMPACT_WH
SNOWFLAKE_DATABASE=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# GitHub App
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Optional AI explanations. Core analysis never requires AI.
AI_ENABLED=false
AI_PROVIDER=
OPENAI_API_KEY=
